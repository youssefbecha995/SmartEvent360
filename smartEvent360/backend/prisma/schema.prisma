generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  ORGANIZER
  USER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

// ─────────────────────────────────────────────
// User
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  nom       String?
  prenom    String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Coordonnées détaillées (clients) ──
  address    String?
  city       String?
  postalCode String?
  profession String?   // profession / activité
  phone      String?   // 1er téléphone
  phone2     String?   // 2ème téléphone
  email2     String?   // 2ème email
  company    String?   // société (client pro)
  cin        String?   // n° carte d'identité / passeport
  matfisc    String?   // matricule fiscal
  notes      String?
  clientType String?   // 'particulier' | 'entreprise'

  // Relations
  events        Event[] @relation("EventOrganizer")
  clientEvents  Event[] @relation("EventClient")
  bookings      Booking[]
  notifications Notification[]

  @@map("users")
}

// ─────────────────────────────────────────────
// Category
// ─────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  color     String?  // ex: "#FF5733" pour l'affichage UI
  createdAt DateTime @default(now())

  events Event[]

  @@map("categories")
}

// ─────────────────────────────────────────────
// Event
// ─────────────────────────────────────────────

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String
  date        DateTime
  imageUrl    String?
  capacity    Int
  price       Float    @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  organizerId String
  organizer   User     @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)

  clientId String?
  client   User?    @relation("EventClient", fields: [clientId], references: [id], onDelete: SetNull)

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  bookings    Booking[]

  @@index([organizerId])
  @@index([clientId])
  @@index([categoryId])
  @@index([date])
  @@map("events")
}

// ─────────────────────────────────────────────
// Booking (Ticket)
// ─────────────────────────────────────────────

model Booking {
  id        String        @id @default(cuid())
  status    BookingStatus @default(PENDING)
  qrCode    String?       @unique // code généré à la confirmation
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relations
  userId  String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventId String
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId]) // un utilisateur ne peut réserver qu'une fois par événement
  @@index([userId])
  @@index([eventId])
  @@map("bookings")
}

// ─────────────────────────────────────────────
// Pack (Offre commerciale)
// ─────────────────────────────────────────────

model Pack {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?  // image représentative du pack
  features    Json?    // prestations incluses (tableau de chaînes, ex: ["Sonorisation", "DJ"])
  price       Float
  duration    Int      @default(4)  // heures incluses
  maxGuests   Int      @default(100)
  badge       String?  // ex: "⭐ Populaire"
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("packs")
}

// ─────────────────────────────────────────────
// CrmRecord (stockage générique des données CRM)
// kind = "equipment" | "personnel" | "maintenance" | ...
// ─────────────────────────────────────────────

model CrmRecord {
  id        String   @id @default(cuid())
  kind      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@map("crm_records")
}

// ─────────────────────────────────────────────
// Notification
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType @default(INFO)
  title     String
  message   String
  lien      String?          // route frontend cible (ex: "/admin/rendez-vous")
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}
